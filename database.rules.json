{
  "rules": {
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },
    "rules": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "whitelist": {
      "$id": {
        ".read": "auth != null && (data.child('uid').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || root.child('admins').child(auth.uid).val() == true)"
      }
    },
    "userApplications": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chat": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid"
      }
    }
  }
}